git history for the token."}], "container": null, "stop_reason": null, "stop_sequence": null, "stop_details": null, "usage": {"input_tokens": 2, "cache_creation_input_tokens": 411, "cache_read_input_tokens": 38394, "cache_creation": {"ephemeral_5m_input_tokens": 0, "ephemeral_1h_input_tokens": 411}, "output_tokens": 4, "service_tier": "standard", "inference_geo": "global", "speed": "standard"}, "input_transformations": [], "diagnostics": null, "context_management": null}, "parent_tool_use_id": null, "timestamp": "2026-10-28T18:50:27.472Z", "request_id": "req_011CgV8vGNxMTwapjjgjc1ao"}
