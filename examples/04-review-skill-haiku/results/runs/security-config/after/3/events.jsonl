ainer": null, "stop_reason": null, "stop_sequence": null, "stop_details": null, "usage": {"input_tokens": 2, "cache_creation_input_tokens": 411, "cache_read_input_tokens": 38394, "cache_creation": {"ephemeral_5m_input_tokens": 0, "ephemeral_1h_input_tokens": 411}, "output_tokens": 2, "service_tier": "standard", "inference_geo": "global", "speed": "standard"}, "input_transformations": [], "diagnostics": null, "context_management": null}, "parent_tool_use_id": null, "timestamp": "2026-10-28T18:51:19.914Z", "request_id": "req_011CgV8z6mcy4yg3GBrZA2mR"}
