          {
            "id": "unittest-only",
            "type": "file_not_contains",
            "description": "",
            "path": "tests/*.py",
            "pattern": "import pytest|from pytest"
          },
          {
            "id": "source-untouched",
            "type": "files_unchanged",
            "description": "",
            "path": "shop/**"
          },
          {
            "id": "suite-passes",
            "type": "check",
            "description": "",
            "run": "python3 -m unittest discover -s tests"
          }
